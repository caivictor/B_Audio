{
  "manifest_version": 3,
  "name": "WebCaptioner",
  "version": "1.0.0",
  "description": "Captures tab audio and streams to local captioning client.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}